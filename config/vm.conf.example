# vm-bhyve example. Replace every REPLACE_* value in a working copy kept
# outside this repository. Do not reuse an evidence UUID or host MAC address.
loader="uefi-custom"
graphics="yes"
graphics_listen="127.0.0.1"
graphics_port="REPLACE_LOOPBACK_VNC_PORT"
graphics_res="1920x1080"
xhci_mouse="yes"
cpu="4"
cpu_sockets="1"
cpu_cores="2"
cpu_threads="2"
memory="12G"
wired_memory="no"
ahci_device_limit="8"
network0_type="virtio-net"
network0_switch="REPLACE_PRIVATE_SWITCH"
network0_mac="REPLACE_UNIQUE_MAC"
utctime="no"
uuid="REPLACE_GENERATED_UUID"
uefi_vars="yes"
disk0_type="ahci-hd"
disk0_name="REPLACE_OPENCORE_IMAGE"
disk1_type="ahci-hd"
disk1_name="REPLACE_MACOS_SYSTEM_DISK"
bhyve_options="-w -o x86.vmexit_on_pause=false"
